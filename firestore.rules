rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /configs/{configId} {
      allow read: if resource.data.status == "approved";
      allow create, update, delete: if isAdmin();
    }
    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.config is map
        && request.resource.data.keys().hasOnly(["uid", "status", "config", "createdAt"]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /votes/{voteId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value in ["like", "dislike", "clear"];
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value in ["like", "dislike", "clear"];
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}